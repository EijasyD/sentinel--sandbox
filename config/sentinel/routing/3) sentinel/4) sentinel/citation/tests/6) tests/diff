         return topi, topv
+
+def make_router(expert_proj: nn.Module, cfg, stats: RunningExpertStats | None = None):
+    """
+    Factory: returns stable router when enabled, else legacy router.
+    """
+    use_stable = bool(getattr(cfg.inference, "stable_fp4_gating", False))
+    if use_stable:
+        return StableTopKRouter(
+            expert_proj=expert_proj,
+            k=getattr(cfg.inference, "moe_top_k", 4),
+            tau=getattr(cfg.inference, "tau", 0.92),
+            ucb_eps=getattr(cfg.inference, "ucb_eps", 0.10),
+            expert_stats=stats
