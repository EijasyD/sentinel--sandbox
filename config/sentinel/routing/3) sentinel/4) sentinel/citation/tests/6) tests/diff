+import dataclasses
+from typing import Sequence
+
+@dataclasses.dataclass
+class CiteGuardConfig:
+    min_cites: int = 3
+    cov_target: float = 0.995  # warn threshold
+
+@dataclasses.dataclass
+class CiteStats:
+    seen: int = 0
+    covered: int = 0
+
+class CiteGuard:
+    """
+    Anchors-first citation floor & coverage tracker.
+    Idempotent: if not wired into your pipeline, no behavior changes elsewhere.
+    """
+    def __init__(self, cfg: CiteGuardConfig):
+        self.cfg = cfg
+        self.stats = CiteStats()
+
+    def ensure_min(self, cites: Sequence[str]) -> bool:
+        """
+        Returns True when min citations satisfied, else False (caller can re-route to retrieval).
+        """
+        self.stats.seen += 1
+        ok = len([c for c in (cites or []) if c]) >= self.cfg.min_cites
+        if ok:
+            self.stats.covered += 1
+        return ok
+
+    def coverage(self) -> float:
+        if self.stats.seen == 0:
+            return 1.0
+        return self.stats.covered / self.stats.seen
+
+    def warn_if_low(self) -> bool:
+        return self.coverage() < self.cfg.cov_target
+
