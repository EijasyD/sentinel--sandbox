+from sentinel.citation.guard import CiteGuard, CiteGuardConfig
+
+def test_min_cites_and_coverage():
+    g = CiteGuard(CiteGuardConfig(min_cites=3, cov_target=0.995))
+    assert g.ensure_min(["a","b","c"]) is True
+    assert g.ensure_min(["a"]) is False
+    cov = g.coverage()
+    assert 0.0 <= cov <= 1.0
+    # After 2 checks, 1 covered → 0.5 coverage; should warn (< 0.995)
+    assert g.warn_if_low() is True
