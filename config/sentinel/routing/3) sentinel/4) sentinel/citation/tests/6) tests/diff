 import torch
 
-# legacy: simple entropy threshold (left unchanged)
+# legacy: simple entropy threshold (left unchanged)
 def entropy_exit(prob, thresh: float = 0.05):
     ent = -(prob * (prob + 1e-9).log()).sum(dim=-1)
     return (ent < thresh)
 
+class MovingZCalibrator:
+    """
+    Consistent early-exit calibrator to prevent flip-flop under token thinning.
+    Uses moving mean/std of confidence deltas; exits when z < delta_z.
+    """
+    def __init__(self, window: int = 32, delta_z: float = -0.5):
+        self.window = window
+        self.delta_z = delta_z
+        self.buf = []
+
+    def should_exit(self, conf_now: torch.Tensor, conf_prev: torch.Tensor | None) -> bool:
+        # conf_*: scalar confidences (e.g., 1 - entropy)
+        if conf_prev is None:
+            return False
+        delta = (conf_now - conf_prev).item()
+        self.buf.append(delta)
+        if len(self.buf) > self.window:
+            self.buf.pop(0)
+        if len(self.buf) < 8:
+            return False
+        import statistics as stats
+        mu = stats.mean(self.buf)
+        sigma = max(stats.pstdev(self.buf), 1e-6)
+        z = (delta - mu) / sigma
+        return z < self.delta_z
+
+def make_exit_policy(cfg):
+    """
+    Factory: returns callable(policy) that combines legacy entropy check
+    with moving-z consistency gate when cfg.inference.early_exit is True.
+    """
+    if not getattr(cfg.inference, "early_exit", False):
+        return lambda prob, prev_conf=None: entropy_exit(prob)
+    calib = MovingZCalibrator()
+    def policy(prob, prev_conf=None):
+        ent = -(prob * (prob + 1e-9).log()).sum(dim=-1)
+        conf = 1.0 - ent.mean()  # batch scalar proxy
+        return calib.should_exit(torch.tensor(conf), None if prev_conf is None else torch.tensor(prev_conf))
+    return policy
+
diff --git a/tests/test_router_fp4_stability.py b/tests/test_router_fp4_stability.py
