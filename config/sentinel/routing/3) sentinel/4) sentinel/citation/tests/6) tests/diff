+from torch import nn
+import torch
+
+# --- AEAP7.1 additions: FP4-stable gating + ε-UCB prior mix (idempotent) ---
+
+def _stable_softmax(logits: torch.Tensor, tau: float) -> torch.Tensor:
+    """
+    Numerically-stable softmax for low-precision (e.g., FP4) pipelines.
+    Subtract per-row max, clamp to [-12,12], then softmax at temperature tau.
+    """
+    if logits.dtype != torch.float32:
+        logits = logits.float()
+    m = logits.max(dim=-1, keepdim=True).values
+    z = (logits - m).clamp_(-12.0, 12.0)
+    return torch.softmax(z / tau, dim=-1)
+
+def _ucb_prior(counts: torch.Tensor, rewards: torch.Tensor, c: float = 1.5) -> torch.Tensor:
+    """
+    Build a probability prior over experts using UCB1 scores.
+    counts/rewards are EMA aggregates per expert (shape [E]).
+    """
+    E = counts.numel()
+    safe_counts = torch.clamp(counts, min=1.0)
+    N = safe_counts.sum()
+    bonus = c * torch.sqrt(torch.log(N + 1.0) / safe_counts)
+    scores = (rewards + bonus).clamp_min(0.0)
+    s = scores.sum()
+    if s <= 0:
+        return torch.full_like(scores, 1.0 / E)
+    return scores / s
+
+class RunningExpertStats(nn.Module):
+    """
+    Lightweight, optional state to track per-expert usage & reward.
+    Idempotent: if never provided/updated, router reduces to existing behavior.
+    """
+    def __init__(self, num_experts: int, ema: float = 0.9):
+        super().__init__()
+        self.register_buffer("counts", torch.ones(num_experts))
+        self.register_buffer("rewards", torch.zeros(num_experts))
+        self.ema = ema
+
+    @torch.no_grad()
+    def update(self, expert_idx: torch.Tensor, reward: torch.Tensor):
+        # expert_idx: [B, k], reward: [B] or [B, k] → reduce to per-expert sum
+        flat_idx = expert_idx.reshape(-1)
+        if reward.dim() > 1:
+            flat_reward = reward.reshape(-1)
+        else:
+            # broadcast each reward across its k experts
+            k = expert_idx.size(-1)
+            flat_reward = reward.repeat_interleave(k)
+        # counts (ema-like accumulation)
+        self.counts[flat_idx] = self.ema * self.counts[flat_idx] + (1.0 - self.ema) * (1.0)
+        # rewards (ema of observed reward proxy, e.g., token likelihood gain)
+        self.rewards[flat_idx] = self.ema * self.rewards[flat_idx] + (1.0 - self.ema) * flat_reward
+
+class StableTopKRouter(nn.Module):
+    """
+    Drop-in router that:
+      1) stabilizes gating for FP4 (clamp + stable softmax)
+      2) blends with a UCB prior distribution (ε mix) to reduce expert skew/dup
+    If disabled via config, existing router path remains unchanged.
+    """
+    def __init__(self, expert_proj: nn.Module, k: int = 4, tau: float = 0.92,
+                 ucb_eps: float = 0.10, expert_stats: RunningExpertStats | None = None):
+        super().__init__()
+        self.expert_proj = expert_proj
+        self.k = k
+        self.tau = tau
+        self.ucb_eps = ucb_eps
+        self.stats = expert_stats
+
+    def forward(self, h: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        # logits: [B, E]
+        logits = self.expert_proj(h)
+        probs = _stable_softmax(logits, tau=self.tau)  # FP4-friendly
+        if self.stats is not None and self.ucb_eps > 0.0:
+            prior = _ucb_prior(self.stats.counts, self.stats.rewards)  # [E]
+            probs = (1.0 - self.ucb_eps) * probs + self.ucb_eps * prior
+            probs = probs / probs.sum(dim=-1, keepdim=True)  # renorm
+        topv, topi = torch.topk(probs, k=self.k, dim=-1)  # [B, k]
+        return topi, topv
+
