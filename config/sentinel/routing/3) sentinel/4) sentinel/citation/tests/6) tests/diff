index 0000000..3b12cde
--- /dev/null
+++ b/tests/test_router_fp4_stability.py
@@ -0,0 +1,65 @@
+import torch
+from torch import nn
+from sentinel.routing.gating import StableTopKRouter, RunningExpertStats
+
+class DummyProj(nn.Module):
+    def __init__(self, d_in=8, experts=16):
+        super().__init__()
+        self.lin = nn.Linear(d_in, experts, bias=False)
+        nn.init.uniform_(self.lin.weight, a=-0.01, b=0.01)
+    def forward(self, x): return self.lin(x)
+
+def test_shapes_and_probs_sum():
+    torch.manual_seed(0)
+    B, D, E, K = 4, 8, 16, 4
+    proj = DummyProj(D, E)
+    x = torch.randn(B, D).to(torch.float16)  # simulate low-precision activation
+    router = StableTopKRouter(proj, k=K, tau=0.92, ucb_eps=0.10)
+    idx, val = router(x)
+    assert idx.shape == (B, K)
+    assert val.shape == (B, K)
+    # ensure probabilities are in [0,1] and top-k sums <= 1
+    assert torch.all((val >= 0) & (val <= 1))
+    assert torch.all(val.sum(dim=-1) <= 1.0 + 1e-5)
+
+def test_ucb_mix_idempotent_without_stats():
+    B, D, E, K = 2, 8, 8, 4
+    proj = DummyProj(D, E)
+    x = torch.randn(B, D)
+    r1 = StableTopKRouter(proj, k=K, tau=0.92, ucb_eps=0.10, expert_stats=None)
+    idx1, val1 = r1(x)
+    # re-run: deterministic given same seed/weights → stable
+    idx2, val2 = r1(x)
+    assert torch.allclose(val1, val2, atol=1e-5)
+
+def test_stats_update_and_prior_changes_distribution():
+    B, D, E, K = 2, 8, 8, 4
+    proj = DummyProj(D, E)
+    x = torch.randn(B, D)
+    stats = RunningExpertStats(num_experts=E)
+    r = StableTopKRouter(proj, k=K, tau=0.92, ucb_eps=0.10, expert_stats=stats)
+    idx, val = r(x)
+    stats.update(idx, torch.ones(B, K))
+    idx2, val2 = r(x)
+    # distribution should shift slightly after rewards
+    assert not torch.allclose(val, val2)
+
